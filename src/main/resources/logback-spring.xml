<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <conversionRule conversionWord="clr"
                    converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex"
                    converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>

    <!--
        %clr(text){color} 에서 color 미지정 시 레벨에 따라 자동 색상:
          ERROR → red  |  WARN → yellow  |  INFO → green  |  DEBUG → cyan  |  TRACE → faint
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{HH:mm:ss.SSS}){faint} %clr(%-5level) %clr(│){faint} %clr(%-36.36logger{32}){cyan} %clr(:){faint} %m%n%wex</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 우리 앱: DEBUG 이상 출력 -->
    <logger name="com.myproject.itemlink" level="DEBUG"/>

    <!-- Spring 노이즈 억제 -->
    <logger name="org.springframework"                      level="WARN"/>
    <logger name="org.springframework.web"                  level="INFO"/>
    <logger name="org.springframework.boot.web.embedded"    level="INFO"/>

    <!-- Hibernate: SQL만 보이게 -->
    <logger name="org.hibernate"                            level="WARN"/>
    <logger name="org.hibernate.SQL"                        level="DEBUG"/>
    <logger name="org.hibernate.orm.jdbc.bind"              level="TRACE"/>
    <logger name="org.hibernate.orm.jdbc.error"             level="ERROR"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
